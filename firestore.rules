rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone can read the site text (the public page needs it). Only accounts
// listed in the `admins` collection (document ID = the account's UID) can
// change it. Signing in alone is not enough: Firebase lets anyone create an
// email/password account, so the admins list is what actually protects edits.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /site/content {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.size() <= 100;
    }

    // Admins are added by hand in the Firebase console, never from the site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
